# @BotFather dan olingan token
BOT_TOKEN=123456:ABC-DEF...
# Ma'lumotlar bazasi fayli
DB_PATH=taxi.db
# Haydovchi shuncha daqiqada javob bermasa, so'rov keyingi haydovchiga o'tadi
OFFER_TIMEOUT_MIN=5
# Adminlar Telegram ID raqamlari (vergul bilan). ID'ni bilish uchun botga /id yozing
ADMIN_IDS=

# --- Ovozli xabarlar (ixtiyoriy) ---
# Ikkala kalit ham yozilsa, bot ovozli xabardan e'lon tuza oladi.
# Claude API kaliti (console.anthropic.com) — matndan ma'lumot ajratish uchun
ANTHROPIC_API_KEY=
# Ovozni matnga aylantirish xizmati kaliti (standart: OpenAI Whisper, platform.openai.com)
STT_API_KEY=
# Boshqa OpenAI-mos xizmat ishlatilsa, manzil va modelni o'zgartiring
# STT_URL=https://api.openai.com/v1/audio/transcriptions
# STT_MODEL=whisper-1
# STT_LANGUAGE=uz
